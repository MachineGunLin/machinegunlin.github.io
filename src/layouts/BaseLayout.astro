---
import 'katex/dist/katex.min.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE, type PostLanguage } from '../site.config';
import '../styles/global.css';

interface AlternateLink {
  lang: PostLanguage;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  lang?: PostLanguage;
  canonicalPath?: string;
  alternateLinks?: AlternateLink[];
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
}

const {
  title,
  description = SITE.description,
  lang = 'zh-CN',
  canonicalPath = Astro.url.pathname,
  alternateLinks = [],
  type = 'website',
  publishedTime,
  updatedTime,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.subtitle}`;
const siteBase = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(canonicalPath, siteBase);
const socialImage = new URL('/og-default.png', siteBase);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={new URL('/rss.xml', siteBase)} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={new URL(link.href, siteBase)} />
    ))}
    {alternateLinks.length > 1 && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternateLinks.find((link) => link.lang === 'zh-CN')?.href ?? canonicalPath, siteBase)} />
    )}

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
